# Copy this file to .env and fill it in. Never commit .env.

# --- Required ---------------------------------------------------------------
# The address you open the web UI on. Used for the Strava login redirect.
PUBLIC_URL=http://192.168.1.10:8080
# Password for the web UI (any username works).
ADMIN_PASSWORD=change-me
# Secret for the /sync URL, e.g. output of: openssl rand -hex 16
SYNC_TOKEN=
# Encrypts stored Strava/Polar credentials. Keep it; changing it means logging in again.
# e.g. output of: openssl rand -hex 32
SECRET_KEY=

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Schedule -----------------------------------------------------------------
TZ=Europe/London
SYNC_TIMES=06:00,12:00,18:00,23:00

# --- What to sync -------------------------------------------------------------
# Only Strava activities whose device name contains one of these (comma separated).
# Empty = all non-manual activities.
DEVICE_FILTER=WorkOutDoors
GARMIN_ENABLED=true
POLAR_ENABLED=true
# Label the FIT file as a Garmin watch so Garmin computes Training Effect/Load.
GARMIN_SPOOF_DEVICE=false
# Garmin product id used when spoofing (3113 = Forerunner 945)
GARMIN_SPOOF_PRODUCT=3113
# Automatic retries per activity and service before it needs a manual resend
MAX_ATTEMPTS=3

# --- Failure emails (optional) -----------------------------------------------
# Gmail: create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
